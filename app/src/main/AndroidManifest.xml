<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 模块描述：LSPosed 管理器的模块列表读 android:description（现代 API 没有 xposeddescription 元数据），
         类型是 reference，必须引用资源、不能写字面量 -->
    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:allowBackup="false">

        <!-- M4 五屏入口 -->
        <activity
            android:name="io.github.vstory.notifyguard.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotifyGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- libxposed service: 框架往模块进程发 binder 必须声明（authorities 用 ${applicationId} 占位） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />
    </application>
</manifest>
