<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="NotifyGuard"
        android:allowBackup="false">

        <!-- M4 五屏入口 -->
        <activity
            android:name="io.github.vstory.notifyguard.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotifyGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 临时配置页：非 launcher（由「设置」屏进入），五屏填完后删除 -->
        <activity
            android:name="io.github.vstory.notifyguard.ui.ConfigActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- libxposed service: 框架往模块进程发 binder 必须声明（authorities 用 ${applicationId} 占位） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />
    </application>
</manifest>
