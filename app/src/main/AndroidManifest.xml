<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="NotifyGuard"
        android:allowBackup="false">

        <!-- 配置入口。M4 换成 Material 3 五屏后本页删除 -->
        <activity
            android:name="io.github.vstory.notifyguard.ui.ConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- libxposed service: 框架往模块进程发 binder 必须声明（authorities 用 ${applicationId} 占位） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />

        <!-- 记录回流（system_server → App）。exported 是必需的：跨 uid 访问非 exported 的 provider 会被系统拒；
             访问控制只能写在 provider 代码里（只收 SYSTEM_UID 与自身） -->
        <provider
            android:name="io.github.vstory.notifyguard.provider.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
